{
    "name": "caforum/santaclauswalk",
    "type": "phpbb-extension",
    "description": "A Santa Claus walking across the header, configurable from the ACP",
    "homepage": "https://forums.caforum.fr/",
    "version": "2.1.2-pl2",
    "time": "2026-11-18",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Thorsten Ahlers",
            "homepage": "https://github.com/IMC-GER/",
            "role": "Developer"
        },
        {
            "name": "Fred Rimbert",
            "email": "contact@caforum.fr",
            "homepage": "https://caforum.fr/forum/",
            "role": "Previous Developer"
        }
    ],
    "require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Santa Claus walk fork IMC",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0"
        },
        "version-check": {
            "host": "caforum.fr",
            "directory": "/versions",
            "filename": "santawalk_version.json",
            "ssl": true
        }
    }
}
